rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in Google account can only read and write its own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
